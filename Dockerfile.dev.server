FROM golang:1.25-alpine
WORKDIR /tex

RUN apk update \
    && apk add --no-cache \
    git \
    ca-certificates \
    tzdata \
    make \
    && update-ca-certificates


RUN go install github.com/air-verse/air@v1.67.1 && go install github.com/go-delve/delve/cmd/dlv@v1.27.2


ENV PATH="/go/bin:${PATH}"
ENV GO111MODULE="on"
ENV GOOS="linux"
ENV CGO_ENABLED=0

ENTRYPOINT ["air"]

